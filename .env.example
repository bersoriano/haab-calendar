NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOB_READ_WRITE_TOKEN=
# Shared secret for scheduled workers. The integration-outbox cron route
# rejects every request without "Authorization: Bearer $CRON_SECRET", and
# rejects all of them when this is unset.
CRON_SECRET=

# Stripe. All three are read at call time, never at import, so a build without
# them succeeds; the webhook route refuses every request while the webhook
# secret is unset rather than accepting unverified events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe product ids that grant premium. Empty grants nothing.
STRIPE_PREMIUM_PRODUCT_IDS=

# Optional. With no exporter configured the application starts and runs
# normally; instrumentation.ts registers a provider and the SDK drops spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Google Calendar. Read lazily, so a build without them succeeds and the
# feature simply stays unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# 32 random bytes, base64. Seals refresh tokens before they reach the database:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# During a key rotation, the previous key stays here so existing rows keep
# opening. Remove it once every row has been rewritten at the current version.
GOOGLE_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Stamped into every managed event. Keep it distinct per deployment, or staging
# could adopt a production booking's calendar event.
HAAB_DEPLOYMENT_NAMESPACE=local
# Push notifications are not configured separately: the address Google delivers
# to is derived from GOOGLE_OAUTH_REDIRECT_URI's origin, plus
# /api/webhooks/google-calendar. Google requires HTTPS, so a local deployment
# creates no watch channels and falls back to the periodic workers — which is
# why busy blocking and two-way still work locally, just less promptly.

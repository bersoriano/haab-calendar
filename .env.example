NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOB_READ_WRITE_TOKEN=
# Shared secret for scheduled workers. The integration-outbox cron route
# rejects every request without "Authorization: Bearer $CRON_SECRET", and
# rejects all of them when this is unset.
CRON_SECRET=

# Stripe. All three are read at call time, never at import, so a build without
# them succeeds; the webhook route refuses every request while the webhook
# secret is unset rather than accepting unverified events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe product ids that grant premium. Empty grants nothing.
STRIPE_PREMIUM_PRODUCT_IDS=
